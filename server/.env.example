PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/notebooklm

# Better Auth
BETTER_AUTH_SECRET=your-random-secret-here
BETTER_AUTH_URL=http://localhost:5000

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenRouter (AI Provider - used for chat + RAG query embedding)
OPENROUTER_API_KEY=your-openrouter-api-key

# Tavily (Web Search)
TAVILY_API_KEY=tvly-your-tavily-api-key

# Inngest Cloud event key — authenticates events sent via queueService.dispatch().
# REQUIRED in production. Leave blank for local dev with `npx inngest-cli@latest dev`.
INNGEST_EVENT_KEY=

# Note: Firecrawl, Cloudinary, and YouTube ingestion credentials now live in
# /worker's own .env — background job processing (source ingestion,
# conversation summaries) runs as a separate service. See worker/.env.example.
