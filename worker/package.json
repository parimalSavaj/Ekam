{
  "name": "worker",
  "version": "1.0.0",
  "description": "Standalone Inngest job runner for NotebookLM Clone. Runs independently from `server` and exposes only the /api/inngest endpoint.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:5001/api/inngest",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js"
  },
  "keywords": [],
